msgid "boop!"
msgstr "ťuk!"

msgid "THUMP!"
msgstr "DUP!"

msgid "Hey! No chewing cables!"
msgstr "Hej! Kabely se nekoušou!"

msgid "purr~"
msgstr "vrrr~"

msgid "Blurry"
msgstr "Rozmazané"

msgid "Shy"
msgstr "Plachý"

msgid "Curious"
msgstr "Zvědavý"

msgid "Friendly"
msgstr "Přátelský"

msgid "Trusting"
msgstr "Důvěřivý"

msgid "Cuddly"
msgstr "Mazlivý"

msgid "Bonded"
msgstr "Oddaný"

msgid "Best buds"
msgstr "Nejlepší kámoši"

msgid "Pellets"
msgstr "Granule"

msgid "5 bowls of crunchy pellets."
msgstr "5 misek křupavých granulí."

msgid "Meadow hay"
msgstr "Luční seno"

msgid "5 armfuls of hay. Bunnies should always have hay!"
msgstr "5 náručí sena. Králíci by měli mít seno pořád!"

msgid "Parsley"
msgstr "Petržel"

msgid "Healthy green snack."
msgstr "Zdravá zelená svačinka."

msgid "Carrot"
msgstr "Mrkev"

msgid "Crunchy and sweet. Don't overdo it."
msgstr "Křupavá a sladká. Nepřeháněj to."

msgid "Apple slice"
msgstr "Plátek jablka"


msgid "Leafy branch"
msgstr "Větvička s listím"

msgid "Fresh branch with leaves. He eats the lot, leaves first. Keeps him off cables."
msgstr "Čerstvá větvička s listy. Sní ji celou, listí jako první. Odvede ho od kabelů."

msgid "Rainbow ball"
msgstr "Duhový míček"

msgid "To nudge, toss and chase."
msgstr "Na šťouchání, házení a honění."

msgid "Cardboard castle"
msgstr "Kartonový hrad"

msgid "A hideout. Very important bunny business."
msgstr "Úkryt. Velmi důležitá králičí záležitost."

msgid "Play tunnel"
msgstr "Tunel na hraní"

msgid "Zoom in one end, out the other."
msgstr "Jedním koncem dovnitř, druhým ven."

msgid "Cushy bed"
msgstr "Měkký pelíšek"

msgid "Naps here restore energy faster."
msgstr "Šlofík tady doplní energii rychleji."

msgid "Cozy rug"
msgstr "Útulný koberec"

msgid "Soft paws, happy bunny."
msgstr "Měkké tlapky, šťastný králík."

msgid "Potted fern"
msgstr "Kapradina v květináči"

msgid "Makes photos look fancier."
msgstr "Fotky s ní vypadají parádněji."

msgid "Floor lamp"
msgstr "Stojací lampa"

msgid "Warm light in the evening."
msgstr "Večer hřejivé světlo."

msgid "Balcony netting"
msgstr "Síť na balkon"

msgid "Makes the balcony bunny-safe, so Bubák can go out and enjoy the fresh air."
msgstr "Zabezpečí balkon, aby mohl Bubák ven na čerstvý vzduch."

msgid "Cable cover"
msgstr "Kryt na kabel"

msgid "Protects the laptop charger from Bubák's teeth. Forever."
msgstr "Ochrání nabíječku od notebooku před Bubákovými zuby. Navždy."

msgid "Food bowl"
msgstr "Miska na jídlo"

msgid "Water bowl"
msgstr "Miska na vodu"

msgid "Hay rack"
msgstr "Jesličky na seno"

msgid "Litter box"
msgstr "Záchodek"

msgid "Herb planter"
msgstr "Truhlík s bylinkami"

msgid "Sunny spot"
msgstr "Sluníčkové místečko"

msgid "Hop hop"
msgstr "Hop hop"

msgid "Just getting around."
msgstr "Jen se tak přesouvá."

msgid "Sitting pretty"
msgstr "Spořádaně sedí"

msgid "Nose going a mile a minute."
msgstr "Čumáček jede jako o závod."

msgid "Nom nom"
msgstr "Mňam mňam"

msgid "Pellets from the bowl. Every last one."
msgstr "Granule z misky. Do poslední."

msgid "Hay muncher"
msgstr "Senožrout"

msgid "Hay keeps teeth and tummy healthy."
msgstr "Seno udržuje zdravé zuby i bříško."

msgid "Slurp"
msgstr "Srk srk"

msgid "Staying hydrated."
msgstr "Pitný režim dodržen."

msgid "Litter pro"
msgstr "Záchodový profík"

msgid "Good bunny, uses the litter box!"
msgstr "Hodný králík, chodí na záchodek!"

msgid "Bunny loaf"
msgstr "Králičí bochníček"

msgid "Paws tucked in. Perfectly baked."
msgstr "Tlapky schované. Dokonale upečený."

msgid "Nap time"
msgstr "Šlofík"

msgid "Rabbits nap a lot in the middle of the day."
msgstr "Králíci přes poledne hodně podřimují."

msgid "Face wash"
msgstr "Umývání"

msgid "Licks paws, washes ears. Very thorough."
msgstr "Olízne tlapky, umyje si uši. Velmi důkladně."

msgid "Treat time"
msgstr "Pamlsek"

msgid "Eating a treat from your hand."
msgstr "Jí pamlsek z tvé ruky."

msgid "Box fort"
msgstr "Krabicová pevnost"

msgid "Somewhere in there is a bunny."
msgstr "Někde tam uvnitř je králík."

msgid "Ball toss"
msgstr "Hod míčkem"

msgid "Nudge, flip, chase!"
msgstr "Šťouchnout, přehodit, honit!"

msgid "Tunnel dash"
msgstr "Tunelový sprint"

msgid "In one end, out the other."
msgstr "Tam a zpátky tunelem!"

msgid "Branch muncher"
msgstr "Větvožrout"

msgid "Leaves first, then the bark. Great for his teeth."
msgstr "Nejdřív listí, potom kůra. Skvělé na zuby."

msgid "Cozy bed nap"
msgstr "Šlofík v pelíšku"

msgid "Snoozing in his very own bed."
msgstr "Podřimuje ve svém vlastním pelíšku."

msgid "Fresh air"
msgstr "Čerstvý vzduch"

msgid "His first trip out onto the balcony."
msgstr "Jeho první výlet na balkon."

msgid "Sunbathing"
msgstr "Opalování"

msgid "Stretched out in a warm patch of sun."
msgstr "Natažený na teplém sluníčku."

msgid "Bird watching"
msgstr "Pozorování ptáků"

msgid "Up on his hind legs, very interested in that pigeon."
msgstr "Na zadních, velmi zaujatý tím holubem."

msgid "Herb thief"
msgstr "Zloděj bylinek"

msgid "Those herbs were for cooking. Were."
msgstr "Ty bylinky byly na vaření. Byly."

msgid "A warning stomp. Something scared him."
msgstr "Varovné dupnutí. Něco ho vylekalo."

msgid "Cable crime"
msgstr "Kabelový zločin"

msgid "Caught red-pawed. Naughty!"
msgstr "Přistižen při činu. Zlobidlo!"

msgid "Chinning"
msgstr "Značkování"

msgid "Rubs his chin on things: \"this is MINE.\""
msgstr "Otírá si bradu o věci: \"tohle je MOJE.\""

msgid "Begging"
msgstr "Škemrání"

msgid "Stands tall when he knows you have treats."
msgstr "Staví se na zadní, když ví, že máš pamlsky."

msgid "Bowl flip"
msgstr "Převrácená miska"

msgid "Empty bowl? Unacceptable!"
msgstr "Prázdná miska? Nepřijatelné!"

msgid "Binky!"
msgstr "Binky!"

msgid "A happy jump-twist. Pure joy."
msgstr "Radostný skok s otočkou. Čistá radost."

msgid "Zoomies"
msgstr "Zoomies"

msgid "Sudden laps around the flat at full speed."
msgstr "Najednou kolečka po bytě v plné rychlosti."

msgid "Flop"
msgstr "Plácnutí"

msgid "Falls over on his side. Total trust."
msgstr "Svalí se na bok. Naprostá důvěra."

msgid "Nose bonk"
msgstr "Ťuk čumáčkem"

msgid "Boop! He only does this to his favourite people."
msgstr "Ťuk! To dělá jen svým nejoblíbenějším lidem."

msgid "Selfie together"
msgstr "Společné selfie"

msgid "Cheek to cheek. Your followers can't get enough."
msgstr "Tvářička na tvářičku. Sledující se nemůžou nabažit."

msgid "Tooth purr"
msgstr "Cvakání zoubky"

msgid "Soft teeth-clicking while petted. Bliss."
msgstr "Tiché cvakání zoubky při hlazení. Blaženost."

msgid "Food"
msgstr "Jídlo"

msgid "Toys"
msgstr "Hračky"

msgid "Home"
msgstr "Domov"

msgid "Meet Bubák!\n\nHe's new here and a little shy. Keep his bowls full, clean his litter box and hold your finger on him to pet him gently.\n\nTake photos of the cute things he does to earn coins."
msgstr "Seznam se s Bubákem!\n\nJe tu nový a trochu plachý. Udržuj jeho misky plné, uklízej mu záchodek, a když ho chceš pohladit, jemně na něm podrž prst.\n\nFoť roztomilé věci, které dělá, a vydělávej mince."

msgid "Not enough coins."
msgstr "Nemáš dost mincí."

msgid "You already have enough of those."
msgstr "Těch už máš dost."

msgid "Already installed."
msgstr "Už je nainstalováno."

msgid "Not yet! Bubák needs to trust you more and get more followers."
msgstr "Ještě ne! Bubák ti musí víc důvěřovat a potřebuje víc sledujících."

msgid "munched through some hay"
msgstr "spořádal trochu sena"

msgid "had a good long nap"
msgstr "dal si pořádného šlofíka"

msgid "%d h %d min"
msgstr "%d h %d min"

msgid "%d min"
msgstr "%d min"

msgid "Welcome back! You were away %s.\n\nMeanwhile Bubák %s."
msgstr "Vítej zpátky! Nebylo tě tu %s.\n\nBubák mezitím %s."

msgid "He's looking at his empty bowls rather pointedly..."
msgstr "Dost významně se dívá na své prázdné misky..."

msgid "Food: tap the bowl to add pellets, the hay rack to add hay. Treats help too."
msgstr "Jídlo: ťukni na misku a přidej granule, na jesličky a přidej seno. Pomůžou i pamlsky."

msgid "Water: tap the water bowl to refill it."
msgstr "Voda: ťukni na misku s vodou a dolij ji."

msgid "Fun: pet Bubák, give him toys from the shop, or toss his ball."
msgstr "Zábava: pohlaď Bubáka, kup mu hračky v obchodě nebo mu hoď míček."

msgid "Clean: tap the litter box to clean it, and pick up any droppings."
msgstr "Čistota: ťukni na záchodek a ukliď ho. A posbírej bobky."

msgid "Treats"
msgstr "Pamlsky"

msgid "Shop"
msgstr "Obchod"

msgid "Photo"
msgstr "Foto"

msgid "Journal"
msgstr "Deník"

msgid "Move"
msgstr "Přesunout"

msgid "No treats left. The shop has some!"
msgstr "Pamlsky došly. V obchodě nějaké mají!"

msgid "Pick a treat to hand-feed:"
msgstr "Vyber pamlsek a nakrm ho z ruky:"

msgid "Done"
msgstr "Hotovo"

msgid "Snap!"
msgstr "Cvak!"

msgid "Close"
msgstr "Zavřít"

msgid "Selfie"
msgstr "Selfie"

msgid "Catch Bubák doing something cute!\nSparkles mean a rare moment."
msgstr "Vyfoť Bubáka, když dělá něco roztomilého!\nJiskřičky znamenají vzácnou chvíli."

msgid "Patience left"
msgstr "Zbývající trpělivost"

msgid "Put him down"
msgstr "Postavit na zem"

msgid "Trust: %s"
msgstr "Důvěra: %s"

msgid "Drag furniture and toys to rearrange the room."
msgstr "Přetahuj nábytek a hračky a uspořádej si pokoj."

msgid "Tap the floor to offer the %s."
msgstr "Ťukni na podlahu a nabídni mu: %s."

msgid "Cancel"
msgstr "Zrušit"

msgid "New behaviour: %s  (see Journal)"
msgstr "Nové chování: %s  (viz Deník)"

msgid "Milestone reached!"
msgstr "Milník splněn!"

msgid "Bubák trusts you and %d people follow his adventures. Time for some fresh air!"
msgstr "Bubák ti důvěřuje a jeho dobrodružství sleduje %d lidí. Je čas na čerstvý vzduch!"

msgid "Make the balcony bunny-safe with Balcony netting (Shop, Home tab), and the door to the balcony will open."
msgstr "Zabezpeč balkon sítí (Obchod, záložka Domov) a dveře na balkon se otevřou."

msgid "Can't wait!"
msgstr "Už se nemůžu dočkat!"

msgid "Bubák trusts you more!"
msgstr "Bubák ti víc důvěřuje!"

msgid "He now feels %s with you."
msgstr "Nová úroveň důvěry: %s."

msgid "He'll let you pick him up now! Drag him upwards (or tap Selfie in Photo mode) and snap a selfie together."
msgstr "Teď už se nechá vzít do náruče! Táhni ho prstem nahoru (nebo ťukni na Selfie v režimu Foto) a vyfoťte si společné selfie."

msgid "Aww!"
msgstr "Ňuňu!"

msgid "Let's go!"
msgstr "Jdeme na to!"

msgid "You have %d"
msgstr "Máš: %d"

msgid "Owned %d/%d"
msgstr "Vlastníš %d/%d"

msgid "Locked: needs %s trust + %d followers"
msgstr "Zamčeno: důvěra %s + %d sledujících"

msgid "Unlocked!"
msgstr "Odemčeno!"

msgid "Installed"
msgstr "Nainstalováno"

msgid "The balcony door is open! Bubák will pop out when he feels like it.\nTap the door to go out yourself."
msgstr "Dveře na balkon jsou otevřené! Bubák si tam vyběhne, kdy se mu zachce.\nŤukni na dveře a jdi ven taky."

msgid "%s is in the room now. Use Move to arrange it."
msgstr "%s už je v pokoji. Uspořádat můžeš přes Přesunout."

msgid "Bought %s (x%d)!"
msgstr "Koupeno: %s (x%d)!"

msgid "Bought %s!"
msgstr "Koupeno: %s!"

msgid "Discovered %d of %d"
msgstr "Objeveno %d z %d"

msgid "Needs: %s"
msgstr "Potřeba: %s"

msgid "the balcony"
msgstr "balkon"

msgid "Needs trust: %s"
msgstr "Potřebná důvěra: %s"

msgid "Keep watching..."
msgstr "Pozoruj ho dál..."

msgid "No photos yet. Tap Photo and catch Bubák doing something cute!"
msgstr "Zatím žádné fotky. Ťukni na Foto a vyfoť Bubáka při něčem roztomilém!"

msgid "Bubák, a lilac-grey bunny with one perky ear and one floppy one."
msgstr "Bubák, šedofialový králíček s jedním ouškem vztyčeným a druhým plandavým."

msgid "Personality: cheeky, curious, very food-motivated."
msgstr "Povaha: drzý, zvědavý, hodně motivovaný jídlem."

msgid "Day %d together"
msgstr "Den %d spolu"

msgid "Trust: %s (%d%%)"
msgstr "Důvěra: %s (%d%%)"

msgid "Followers: %d"
msgstr "Sledující: %d"

msgid "Photos taken: %d"
msgstr "Pořízené fotky: %d"

msgid "Treats given: %d"
msgstr "Rozdané pamlsky: %d"

msgid "Cuddle sessions: %d"
msgstr "Mazlení: %d"

msgid "Work shifts: %d"
msgstr "Pracovní směny: %d"

msgid "Oops, missed him!"
msgstr "Jejda, utekl ti ze záběru!"

msgid "NEW!"
msgstr "NOVÉ!"

msgid "Your followers have seen this one a lot lately."
msgstr "Tohle tví sledující poslední dobou viděli už mockrát."

msgid "Nice!"
msgstr "Paráda!"

msgid "Language"
msgstr "Jazyk"

msgid "Settings"
msgstr "Nastavení"

msgid "Coffee break! Back to work in %d s. Go hang out with Bubák."
msgstr "Pauza na kafe! Zpátky do práce za %d s. Zatím se věnuj Bubákovi."

msgid "Remote work"
msgstr "Práce z domova"

msgid "A new charger arrived. Keep an eye on Bubák!"
msgstr "Dorazila nová nabíječka. Dávej na Bubáka pozor!"

msgid "The balcony"
msgstr "Balkon"

msgid "The living room"
msgstr "Obývák"

msgid "The bowl is full."
msgstr "Miska je plná."

msgid "+ pellets"
msgstr "+ granule"

msgid "Out of pellets! Buy more in the shop."
msgstr "Granule došly! Kup další v obchodě."

msgid "Plenty of hay in there already."
msgstr "Sena je tam ještě dost."

msgid "+ hay"
msgstr "+ seno"

msgid "Out of hay! Bunnies need lots of it. Visit the shop."
msgstr "Seno došlo! Králíci ho potřebují hodně. Zajdi do obchodu."

msgid "fresh water!"
msgstr "čerstvá voda!"

msgid "Already spotless."
msgstr "Už je čisťoučký."

msgid "sparkly clean!"
msgstr "blýská se čistotou!"

msgid "Almost! Make the balcony bunny-safe first: Balcony netting is in the Shop (Home)."
msgstr "Skoro! Nejdřív balkon zabezpeč: síť na balkon najdeš v Obchodě (Domov)."

msgid "The balcony door is locked. It opens once Bubák trusts you (%s) and he has %d followers.\nNow: %s, %d followers."
msgstr "Dveře na balkon jsou zamčené. Otevřou se, až ti Bubák bude důvěřovat (%s) a bude mít %d sledujících.\nTeď: %s, sledujících: %d."



msgid "Safe and sound under its cover."
msgstr "V bezpečí pod krytem."

msgid "Chewed through... A cable cover from the shop would prevent this."
msgstr "Překousnutý... Kryt na kabel z obchodu by tomu zabránil."

msgid "Bubák eyes this cable a little too often..."
msgstr "Bubák po tomhle kabelu pokukuje nějak moc často..."

msgid "Comfy. Bubák is not allowed up here. (He disagrees.)"
msgstr "Pohodlné. Bubák sem nahoru nesmí. (On s tím nesouhlasí.)"

msgid "You find a hay stalk between the cushions. How?"
msgstr "Mezi polštáři najdeš stéblo sena. Jak?"

msgid "The sofa has suspicious nibble marks on one leg."
msgstr "Gauč má na jedné noze podezřelé stopy po zoubcích."

msgid "Bubák isn't here. He's %s."
msgstr "Bubák tu není. Je %s."

msgid "out on the balcony"
msgstr "venku na balkoně"

msgid "inside"
msgstr "uvnitř"

msgid "You're out of those."
msgstr "Ty ti došly."


msgid "aww, a paw!"
msgstr "ňuňu, tlapka!"

msgid "Shift over!"
msgstr "Konec směny!"


msgid "Back to Bubák"
msgstr "Zpátky k Bubákovi"

msgid "Behaviours"
msgstr "Chování"

msgid "Photos"
msgstr "Fotky"

msgid "Bubák"
msgstr "Bubák"

msgid "ate %d bowl of pellets"
msgid_plural "ate %d bowls of pellets"
msgstr[0] "snědl %d misku granulí"
msgstr[1] "snědl %d misky granulí"
msgstr[2] "snědl %d misek granulí"

msgid "used the litter box %d time"
msgid_plural "used the litter box %d times"
msgstr[0] "použil záchodek %d×"
msgstr[1] "použil záchodek %d×"
msgstr[2] "použil záchodek %d×"

msgid "%d new behaviour to discover. Keep watching!"
msgid_plural "%d new behaviours to discover. Keep watching!"
msgstr[0] "Můžeš objevit %d nové chování. Pozoruj ho!"
msgstr[1] "Můžeš objevit %d nová chování. Pozoruj ho!"
msgstr[2] "Můžeš objevit %d nových chování. Pozoruj ho!"

msgid "%d like"
msgid_plural "%d likes"
msgstr[0] "%d lajk"
msgstr[1] "%d lajky"
msgstr[2] "%d lajků"

msgid "+%d follower"
msgid_plural "+%d followers"
msgstr[0] "+%d sledující"
msgstr[1] "+%d sledující"
msgstr[2] "+%d sledujících"

msgid "Dig box"
msgstr "Krabice na hrabání"

msgid "A box of sand for very important digging."
msgstr "Krabice s pískem na velmi důležité hrabání."

msgid "Treat puzzle"
msgstr "Pamlskový hlavolam"

msgid "Hides little snacks under the lids. Makes him think."
msgstr "Schovává pod víčky malé pamlsky. Musí přemýšlet."

msgid "Wooden hut"
msgstr "Dřevěný domeček"

msgid "A hideaway that smells like a forest."
msgstr "Úkryt, který voní jako les."

msgid "Bunny castle"
msgstr "Králičí hrad"

msgid "Two floors of castle. He rules from the top."
msgstr "Hrad o dvou patrech. Bubák vládne z vršku."

msgid "Teepee tent"
msgstr "Týpí"

msgid "A tent for very cozy naps."
msgstr "Stan na velmi útulné šlofíky."

msgid "Bean bag"
msgstr "Sedací vak"

msgid "He flops on it like he owns it. He does."
msgstr "Svalí se na něj, jako by mu patřil. Taky že patří."

msgid "Paper lantern"
msgstr "Papírová lucerna"

msgid "A soft glow for the evenings."
msgstr "Jemné světlo na večery."

msgid "Flower pot"
msgstr "Květináč s kytičkami"

msgid "Pretty. Not for eating. Probably."
msgstr "Hezké. Ne k jídlu. Asi."

msgid "Big food bowl"
msgstr "Velká miska na jídlo"

msgid "Holds 5 portions instead of 3."
msgstr "Vejde se do ní 5 porcí místo 3."

msgid "Royal food bowl"
msgstr "Královská miska"

msgid "Holds 8 portions. Fit for a bunny king."
msgstr "Vejde se do ní 8 porcí. Pro králíka krále."

msgid "Big water bowl"
msgstr "Velká miska na vodu"

msgid "Holds more water, so it lasts longer."
msgstr "Vejde se do ní víc vody, takže déle vydrží."

msgid "Water fountain"
msgstr "Pítko s fontánkou"

msgid "Fresh running water. Lasts ages, and drinking is fun."
msgstr "Čerstvá tekoucí voda. Vydrží dlouho a pití je zábava."

msgid "Big hay rack"
msgstr "Velké jesličky"

msgid "Holds more hay, and each refill lasts longer."
msgstr "Vejde se do nich víc sena a každé doplnění vydrží déle."

msgid "Hay house"
msgstr "Senný domeček"

msgid "A hay rack with a roof. Holds a whole bale."
msgstr "Jesličky se stříškou. Vejde se do nich celý balík."

msgid "Corner litter box"
msgstr "Rohový záchodek"

msgid "High back, less mess. Stays clean longer."
msgstr "Vysoká zadní stěna, méně nepořádku. Déle vydrží čistý."

msgid "Luxury litter box"
msgstr "Luxusní záchodek"

msgid "Stays clean much longer. Has ears!"
msgstr "Vydrží čistý mnohem déle. Má ouška!"

msgid "Comfy office chair"
msgstr "Pohodlná kancelářská židle"

msgid "Shorter breaks between work shifts."
msgstr "Kratší pauzy mezi pracovními směnami."

msgid "Second monitor"
msgstr "Druhý monitor"

msgid "+25% pay for remote work."
msgstr "+25 % k výplatě za práci z domova."

msgid "Coffee machine"
msgstr "Kávovar"

msgid "Work shifts last 5 seconds longer."
msgstr "Pracovní směny trvají o 5 sekund déle."

msgid "Noise-cancelling headphones"
msgstr "Sluchátka s potlačením hluku"

msgid "Another +25% pay for remote work."
msgstr "Dalších +25 % k výplatě za práci z domova."

msgid "Red bow"
msgstr "Červená mašle"

msgid "A classic. Photos with an outfit get more likes."
msgstr "Klasika. Fotky s doplňkem mají víc lajků."

msgid "Round glasses"
msgstr "Kulaté brýle"

msgid "Very smart. Very scholarly."
msgstr "Velmi chytré. Velmi učené."

msgid "Flower crown"
msgstr "Věneček z kytiček"

msgid "Spring, all year round."
msgstr "Jaro po celý rok."

msgid "Tiny top hat"
