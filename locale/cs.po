msgstr "Mistrovské certifikáty: %s"

msgid "Duels won: %d of %d"
msgstr "Vyhrané souboje: %d z %d"

msgid "A new rival: %s!"
msgstr "Nový soupeř: %s!"

msgid "Now that Bubák is a national champion, the best bunnies in the world want to beat him. And the old rivals are training harder too."
msgstr "Teď, když je Bubák národní šampion, ho chtějí porazit nejlepší králíci světa. A staří soupeři taky trénují víc."

msgid "Bring it on!"
msgstr "Jen ať přijde!"

msgid "Master's certificate!"
msgstr "Mistrovský certifikát!"

msgid "Duel: %s wants a rematch"
msgstr "Souboj: %s chce odvetu"

msgid "One on one, %s. Win: +%d coins, +%d followers. Ends in %s."
msgstr "Jeden na jednoho, %s. Výhra: +%d mincí, +%d sledujících. Končí za %s."

msgid "Accept"
msgstr "Přijmout"

msgid "Qualifying:"
msgstr "Kvalifikace:"

msgid "qualified!"
msgstr "kvalifikován!"

msgid "Standings: %s"
msgstr "Pořadí: %s"

msgid "Past Games: %s"
msgstr "Minulé hry: %s"

msgid "Bubák finished %s overall with %d points."
msgstr "Bubák skončil celkově %s s %d body."

msgid "And the Bunny Games cup! It's in the flat now."
msgstr "A pohár Králičích her! Už stojí v bytě."

msgid "Bunny Games champion!"
msgstr "Šampion Králičích her!"

msgid "The Bunny Games are over"
msgstr "Králičí hry skončily"

msgid "Challenge of the week"
msgstr "Výzva týdne"

